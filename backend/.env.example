APP_NAME="Commute.ly API"
# JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000"]

# MAPID Activities: backend-only credential.
# Keep real credentials only in backend/.env or the deployment environment.
MAPID_API_KEY=
MAPID_ACTIVITIES_URL=https://server.mapid.io/web/competition/activities
MAPID_LAYER_LIST_URL=https://geoserver.mapid.io/layers_new/get_layer_list
MAPID_LAYER_URL=https://geoserver.mapid.io/layers_new/get_layer

# Paste the existing Supabase PostgreSQL URI into backend/.env only.
# Example format (replace every placeholder; URL-encode password characters):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=

# Backend-only OpenRouteService Directions credential.
ORS_API_KEY=

# Backend-only Gemini credential. Never use a NEXT_PUBLIC_* variable.
GEMINI_API_KEY=
# Optional: set a supported Gemini model ID to override the Settings default.
# GEMINI_MODEL=
